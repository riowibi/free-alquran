  ],
  "totalSurahs": 2,
  "scrapedAt": "2026-03-12T18:05:13.288Z",
  "surahs": [
    {
      "number": 78,
      "name": "النبأ",
      "englishName": "An-Naba'",
      "englishNameTranslation": "Berita Besar",
      "numberOfAyahs": 40,
      "revelationType": "Medinan",
      "verses": [
        {
          "number": 1,
          "text": "عَمَّ يَتَسَاۤءَلُوْنَۚ ",
          "transliteration": "‘Amma yatasā'alūn(a).",
          "indonesianTranslation": "Tentang apakah mereka saling bertanya?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 2,
          "text": "عَنِ النَّبَاِ الْعَظِيْمِۙ ",
          "transliteration": "‘Anin naba'il-‘aẓīm(i).",
          "indonesianTranslation": "Tentang berita yang besar (hari Kebangkitan)",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 3,
          "text": "الَّذِيْ هُمْ فِيْهِ مُخْتَلِفُوْنَۗ ",
          "transliteration": "Allażī hum fīhi mukhtalifūn(a).",
          "indonesianTranslation": "yang dalam hal itu mereka berselisih.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 4,
          "text": "كَلَّا سَيَعْلَمُوْنَۙ ",
          "transliteration": "Kallā saya‘lamūn(a).",
          "indonesianTranslation": "Sekali-kali tidak! Kelak mereka akan mengetahui.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 5,
          "text": "ثُمَّ كَلَّا سَيَعْلَمُوْنَ",
          "transliteration": "Ṡumma kallā saya‘lamūn(a).",
          "indonesianTranslation": "Sekali lagi, tidak! Kelak mereka akan mengetahui.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 6,
          "text": "اَلَمْ نَجْعَلِ الْاَرْضَ مِهٰدًاۙ",
          "transliteration": "Alam naj‘alil-arḍa mihādā(n).",
          "indonesianTranslation": "Bukankah Kami telah menjadikan bumi sebagai hamparan",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 7,
          "text": "وَّالْجِبَالَ اَوْتَادًاۖ",
          "transliteration": "Wal-jibāla autādā(n).",
          "indonesianTranslation": "dan gunung-gunung sebagai pasak?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 8,
          "text": "وَّخَلَقْنٰكُمْ اَزْوَاجًاۙ ",
          "transliteration": "Wa khalaqnākum azwājā(n).",
          "indonesianTranslation": "Kami menciptakan kamu berpasang-pasangan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 9,
          "text": "وَّجَعَلْنَا نَوْمَكُمْ سُبَاتًاۙ ",
          "transliteration": "Wa ja‘alnā naumakum subātā(n).",
          "indonesianTranslation": "Kami menjadikan tidurmu untuk beristirahat.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 10,
          "text": "وَّجَعَلْنَا الَّيْلَ لِبَاسًاۙ ",
          "transliteration": "Wa ja‘alnal-laila libāsā(n).",
          "indonesianTranslation": "Kami menjadikan malam sebagai pakaian.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 11,
          "text": "وَّجَعَلْنَا النَّهَارَ مَعَاشًاۚ",
          "transliteration": "Wa ja‘alnan-nahāra ma‘āsyā(n).",
          "indonesianTranslation": "Kami menjadikan siang untuk mencari penghidupan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 12,
          "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًاۙ ",
          "transliteration": "Wa banainā fauqakum sab‘an syidādā(n).",
          "indonesianTranslation": "Kami membangun tujuh (langit) yang kukuh di atasmu.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 13,
          "text": "وَّجَعَلْنَا سِرَاجًا وَّهَّاجًاۖ",
          "transliteration": "Wa ja‘alnā sirājaw wahhājā(n).",
          "indonesianTranslation": "Kami menjadikan pelita yang terang-benderang (matahari).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 14,
          "text": "وَّاَنْزَلْنَا مِنَ الْمُعْصِرٰتِ مَاۤءً ثَجَّاجًاۙ",
          "transliteration": "Wa anzalnā minal-mu‘ṣirāti mā'an ṡajjājā(n).",
          "indonesianTranslation": "Kami menurunkan dari awan air hujan yang tercurah dengan deras",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 15,
          "text": "لِّنُخْرِجَ بِهٖ حَبًّا وَّنَبَاتًاۙ",
          "transliteration": "Linukhrija bihī ḥabbaw wa nabātā(n).",
          "indonesianTranslation": "agar Kami menumbuhkan dengannya biji-bijian, tanam-tanaman,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 16,
          "text": "وَّجَنّٰتٍ اَلْفَافًاۗ",
          "transliteration": "Wa jannātin alfāfā(n).",
          "indonesianTranslation": "dan kebun-kebun yang rindang.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 17,
          "text": "اِنَّ يَوْمَ الْفَصْلِ كَانَ مِيْقَاتًاۙ",
          "transliteration": "Inna yaumal-faṣli kāna mīqātā(n).",
          "indonesianTranslation": "Sesungguhnya hari Keputusan itu adalah waktu yang telah ditetapkan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 18,
          "text": "يَّوْمَ يُنْفَخُ فِى الصُّوْرِ فَتَأْتُوْنَ اَفْوَاجًاۙ",
          "transliteration": "Yauma yunfakhu fiṣ-ṣūri fa ta'tūna afwājā(n).",
          "indonesianTranslation": "(yaitu) hari (ketika) sangkakala ditiup, lalu kamu datang berbondong-bondong.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 19,
          "text": "وَّفُتِحَتِ السَّمَاۤءُ فَكَانَتْ اَبْوَابًاۙ",
          "transliteration": "Wa futiḥatis-samā'u fa kānat abwābā(n).",
          "indonesianTranslation": "Langit pun dibuka. Maka, terdapatlah beberapa pintu.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 20,
          "text": "وَّسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًاۗ",
          "transliteration": "Wa suyyiratil-jibālu fa kānat sarābā(n).",
          "indonesianTranslation": "Gunung-gunung pun dijalankan. Maka, ia menjadi (seperti) fatamorgana.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 21,
          "text": "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًاۙ",
          "transliteration": "Inna jahannama kānat mirṣādā(n).",
          "indonesianTranslation": "Sesungguhnya (neraka) Jahanam itu (merupakan) tempat mengintai (bagi penjaga neraka)",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 22,
          "text": "لِّلطّٰغِيْنَ مَاٰبًاۙ",
          "transliteration": "Liṭ-ṭāgīna ma'ābā(n).",
          "indonesianTranslation": "(dan) menjadi tempat kembali bagi orang-orang yang melampaui batas.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 23,
          "text": "لّٰبِثِيْنَ فِيْهَآ اَحْقَابًاۚ",
          "transliteration": "Lābiṡīna fīhā aḥqābā(n).",
          "indonesianTranslation": "Mereka tinggal di sana dalam masa yang lama.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 24,
          "text": "لَا يَذُوْقُوْنَ فِيْهَا بَرْدًا وَّلَا شَرَابًاۙ",
          "transliteration": "Lā yażūqūna fīhā bardaw wa lā syarābā(n).",
          "indonesianTranslation": "Mereka tidak merasakan kesejukan di dalamnya dan tidak (pula mendapat) minuman,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 25,
          "text": "اِلَّا حَمِيْمًا وَّغَسَّاقًاۙ",
          "transliteration": "Illā ḥamīmaw wa gassāqā(n).",
          "indonesianTranslation": "selain air yang mendidih dan nanah,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 26,
          "text": "جَزَاۤءً وِّفَاقًاۗ",
          "transliteration": "Jazā'aw wifāqā(n).",
          "indonesianTranslation": "sebagai pembalasan yang setimpal.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 27,
          "text": "اِنَّهُمْ كَانُوْا لَا يَرْجُوْنَ حِسَابًاۙ",
          "transliteration": "Innahum kānū lā yarjūna ḥisābā(n).",
          "indonesianTranslation": "Sesungguhnya mereka tidak pernah mengharapkan perhitungan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 28,
          "text": "وَّكَذَّبُوْا بِاٰيٰتِنَا كِذَّابًاۗ",
          "transliteration": "Wa każżabū bi'āyātinā kiżżābā(n).",
          "indonesianTranslation": "Mereka benar-benar mendustakan ayat-ayat Kami.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 29,
          "text": "وَكُلَّ شَيْءٍ اَحْصَيْنٰهُ كِتٰبًاۙ",
          "transliteration": "Wa kulla syai'in aḥṣaināhu kitābā(n).",
          "indonesianTranslation": "Segala sesuatu telah Kami catat dalam kitab (catatan amal manusia).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 30,
          "text": "فَذُوْقُوْا فَلَنْ نَّزِيْدَكُمْ اِلَّا عَذَابًا ࣖ",
          "transliteration": "Fa żūqū falan nazīdakum illā ‘ażābā(n)",
          "indonesianTranslation": "Oleh karena itu, rasakanlah! Tidak akan Kami tambahkan kepadamu, kecuali azab.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 31,
          "text": "اِنَّ لِلْمُتَّقِيْنَ مَفَازًاۙ",
          "transliteration": "Inna lil-muttaqīna mafāzā(n).",
          "indonesianTranslation": "Sesungguhnya bagi orang-orang yang bertakwa (ada) kemenangan (surga),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 32,
          "text": "حَدَاۤىِٕقَ وَاَعْنَابًاۙ",
          "transliteration": "Ḥadā'iqa wa a‘nābā(n).",
          "indonesianTranslation": "(yaitu) kebun-kebun, buah anggur,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 33,
          "text": "وَّكَوَاعِبَ اَتْرَابًاۙ",
          "transliteration": "Wa kawā‘iba atrābā(n).",
          "indonesianTranslation": "gadis-gadis molek yang sebaya,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 34,
          "text": "وَّكَأْسًا دِهَاقًاۗ",
          "transliteration": "Wa ka'san dihāqā(n).",
          "indonesianTranslation": "dan gelas-gelas yang penuh (berisi minuman).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 35,
          "text": "لَا يَسْمَعُوْنَ فِيْهَا لَغْوًا وَّلَا كِذّٰبًا",
          "transliteration": "Lā yasma‘ūna fīhā lagwaw wa lā kiżżābā(n).",
          "indonesianTranslation": "Di sana mereka tidak mendengar percakapan yang sia-sia dan tidak pula (perkataan) dusta.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 36,
          "text": "جَزَاۤءً مِّنْ رَّبِّكَ عَطَاۤءً حِسَابًاۙ",
          "transliteration": "Jazā'am mir rabbika ‘aṭā'an ḥisābā(n).",
          "indonesianTranslation": "(Hal itu) sebagai balasan (dan) pemberian yang banyak dari Tuhanmu,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 37,
          "text": "رَّبِّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَيْنَهُمَا الرَّحْمٰنِ لَا يَمْلِكُوْنَ مِنْهُ خِطَابًاۚ ",
          "transliteration": "Rabbis-samāwāti wal-arḍi wa mā bainahumar-raḥmāni lā yamlikūna minhu khiṭābā(n).",
          "indonesianTranslation": "(yaitu) Tuhan (pemelihara) langit, bumi, dan apa yang ada di antara keduanya, Yang Maha Pengasih. Mereka tidak memiliki (hak) berbicara dengan-Nya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 38,
          "text": "يَوْمَ يَقُوْمُ الرُّوْحُ وَالْمَلٰۤىِٕكَةُ صَفًّاۙ  لَّا يَتَكَلَّمُوْنَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا",
          "transliteration": "Yauma yaqūmur-rūḥu wal-malā'ikatu ṣaffā(n), lā yatakallamūna illā man ażina lahur-raḥmānu wa qāla ṣawābā(n).",
          "indonesianTranslation": "Pada hari ketika Rūḥ dan malaikat berdiri bersaf-saf. Mereka tidak berbicara, kecuali yang diizinkan oleh Tuhan Yang Maha Pengasih dan dia mengatakan yang benar.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 39,
          "text": "ذٰلِكَ الْيَوْمُ الْحَقُّۚ فَمَنْ شَاۤءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰبًا",
          "transliteration": "Żālikal-yaumul-ḥaqq(u), faman syā'attakhaża ilā rabbihī ma'ābā(n).",
          "indonesianTranslation": "Itulah hari yang hak (pasti terjadi). Siapa yang menghendaki (keselamatan) niscaya menempuh jalan kembali kepada Tuhannya (dengan beramal saleh).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 40,
          "text": "اِنَّآ اَنْذَرْنٰكُمْ عَذَابًا قَرِيْبًا ەۙ يَّوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُوْلُ الْكٰفِرُ يٰلَيْتَنِيْ كُنْتُ تُرٰبًا ࣖ",
          "transliteration": "Innā anżarnākum ‘ażāban qarībā(n), yauma yanẓurul-mar'u mā qaddamat yadāhu wa yaqūlul-kāfiru yā laitanī kuntu turābā(n).",
          "indonesianTranslation": "Sesungguhnya Kami telah memperingatkan kamu akan azab yang dekat pada hari (ketika) manusia melihat apa yang telah diperbuat oleh kedua tangannya dan orang kafir berkata, “Oh, seandainya saja aku menjadi tanah.”",
          "juz": null,
          "page": null,
          "ruku": null
        }
      ]
    },
    {
      "number": 79,
      "name": "النّٰزعٰت",
      "englishName": "An-Nazi'at",
      "englishNameTranslation": "Malaikat Yang Mencabut",
      "numberOfAyahs": 46,
      "revelationType": "Medinan",
      "verses": [
        {
          "number": 1,
          "text": "وَالنّٰزِعٰتِ غَرْقًاۙ",
          "transliteration": "Wan-nāzi‘āti garqā(n).",
          "indonesianTranslation": "Demi (malaikat) yang mencabut (nyawa orang kafir) dengan keras,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 2,
          "text": "وَّالنّٰشِطٰتِ نَشْطًاۙ",
          "transliteration": "Wan-nāsyiṭāti nasyṭā(n).",
          "indonesianTranslation": "demi (malaikat) yang mencabut (nyawa orang mukmin) dengan lemah lembut,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 3,
          "text": "وَّالسّٰبِحٰتِ سَبْحًاۙ",
          "transliteration": "Was-sābiḥāti sabḥā(n).",
          "indonesianTranslation": "demi (malaikat) yang cepat (menunaikan tugasnya) dengan mudah,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 4,
          "text": "فَالسّٰبِقٰتِ سَبْقًاۙ",
          "transliteration": "Fas-sābiqāti sabqā(n).",
          "indonesianTranslation": "(malaikat) yang bergegas (melaksanakan perintah Allah) dengan cepat,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 5,
          "text": "فَالْمُدَبِّرٰتِ اَمْرًاۘ",
          "transliteration": "Fal-mudabbirāti amrā(n).",
          "indonesianTranslation": "dan (malaikat) yang mengatur urusan (dunia),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 6,
          "text": "يَوْمَ تَرْجُفُ الرَّاجِفَةُۙ",
          "transliteration": "Yauma tarjufur-rājifah(tu).",
          "indonesianTranslation": "(kamu benar-benar akan dibangkitkan) pada hari ketika tiupan pertama mengguncang (alam semesta).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 7,
          "text": "تَتْبَعُهَا الرَّادِفَةُ ۗ",
          "transliteration": "Tatba‘uhar-rādifah(tu).",
          "indonesianTranslation": "(Tiupan pertama) itu diiringi oleh tiupan kedua.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 8,
          "text": "قُلُوْبٌ يَّوْمَىِٕذٍ وَّاجِفَةٌۙ",
          "transliteration": "Qulūbuy yauma'iżiw wājifah(tun).",
          "indonesianTranslation": "Hati manusia pada hari itu merasa sangat takut;",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 9,
          "text": "اَبْصَارُهَا خَاشِعَةٌ  ۘ",
          "transliteration": "Abṣāruhā khāsyi‘ah(tun).",
          "indonesianTranslation": "pandangannya tertunduk.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 10,
          "text": "يَقُوْلُوْنَ ءَاِنَّا لَمَرْدُوْدُوْنَ فِى الْحَافِرَةِۗ",
          "transliteration": "Yaqūlūna a'innā lamardūdūna fil-ḥāfirah(ti).",
          "indonesianTranslation": "Mereka (di dunia) berkata, “Apakah kita benar-benar akan dikembalikan pada kehidupan yang semula?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 11,
          "text": "ءَاِذَا كُنَّا عِظَامًا نَّخِرَةً ۗ",
          "transliteration": "A'iżā kunnā ‘iẓāman nakhirah(tan).",
          "indonesianTranslation": "Apabila kita telah menjadi tulang-belulang yang hancur, apakah kita (akan dibangkitkan juga)?”",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 12,
          "text": "قَالُوْا تِلْكَ اِذًا كَرَّةٌ خَاسِرَةٌ  ۘ",
          "transliteration": "Qālū tilka iżan karratun khāsirah(tun).",
          "indonesianTranslation": "Mereka berkata, “Kalau demikian, itu suatu pengembalian yang merugikan.”",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 13,
          "text": "فَاِنَّمَا هِيَ زَجْرَةٌ وَّاحِدَةٌۙ",
          "transliteration": "Fa innamā hiya zajratuw wāḥidah(tun).",
          "indonesianTranslation": "(Jangan dianggap sulit,) pengembalian itu (dilakukan) hanyalah dengan sekali tiupan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 14,
          "text": "فَاِذَا هُمْ بِالسَّاهِرَةِۗ",
          "transliteration": "Fa iżā hum bis-sāhirah(ti).",
          "indonesianTranslation": "Seketika itu, mereka hidup kembali di bumi (yang baru).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 15,
          "text": "هَلْ اَتٰىكَ حَدِيْثُ مُوْسٰىۘ",
          "transliteration": "Hal atāka ḥadīṡu mūsā.",
          "indonesianTranslation": "Sudah sampaikah kepadamu (Nabi Muhammad) kisah Musa?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 16,
          "text": "اِذْ نَادٰىهُ رَبُّهٗ بِالْوَادِ الْمُقَدَّسِ طُوًىۚ",
          "transliteration": "Iż nādāhu rabbuhū bil-wādil-muqaddasi ṭuwā(n).",
          "indonesianTranslation": "(Ingatlah) ketika Tuhannya menyeru dia (Musa) di lembah suci, yaitu Lembah Tuwa,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 17,
          "text": "اِذْهَبْ اِلٰى فِرْعَوْنَ اِنَّهٗ طَغٰىۖ",
          "transliteration": "Iżhab ilā fir‘auna innahū ṭagā.",
          "indonesianTranslation": "“Pergilah engkau kepada Fir‘aun! Sesungguhnya dia telah melampaui batas.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 18,
          "text": "فَقُلْ هَلْ لَّكَ اِلٰٓى اَنْ تَزَكّٰىۙ",
          "transliteration": "Fa qul hal laka ilā an tazakkā.",
          "indonesianTranslation": "Lalu, katakanlah (kepada Fir‘aun), ‘Adakah keinginanmu untuk menyucikan diri (dari kesesatan)",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 19,
          "text": "وَاَهْدِيَكَ اِلٰى رَبِّكَ فَتَخْشٰىۚ",
          "transliteration": "Wa ahdiyaka ilā rabbika fa takhsyā.",
          "indonesianTranslation": "dan aku akan menunjukimu ke (jalan) Tuhanmu agar engkau takut (kepada-Nya)?’”",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 20,
          "text": "فَاَرٰىهُ الْاٰيَةَ الْكُبْرٰىۖ",
          "transliteration": "Fa arāhul-āyatal-kubrā.",
          "indonesianTranslation": "Lalu, dia (Musa) memperlihatkan mukjizat yang besar kepadanya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 21,
          "text": "فَكَذَّبَ وَعَصٰىۖ",
          "transliteration": "Fa każżaba wa ‘aṣā.",
          "indonesianTranslation": "Akan tetapi, dia (Fir‘aun) mendustakan (kerasulan) dan mendurhakai (Allah).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 22,
          "text": "ثُمَّ اَدْبَرَ يَسْعٰىۖ",
          "transliteration": "Ṡumma adbara yas‘ā.",
          "indonesianTranslation": "Kemudian, dia berpaling seraya berusaha (menantang Musa).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 23,
          "text": "فَحَشَرَ فَنَادٰىۖ",
          "transliteration": "Fa ḥasyara fanādā.",
          "indonesianTranslation": "Maka, dia mengumpulkan (pembesar-pembesarnya), lalu berseru (memanggil kaumnya).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 24,
          "text": "فَقَالَ اَنَا۠ رَبُّكُمُ الْاَعْلٰىۖ",
          "transliteration": "Fa qāla ana rabbukumul-a‘lā.",
          "indonesianTranslation": "Dia berkata, “Akulah Tuhanmu yang paling tinggi.”",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 25,
          "text": "فَاَخَذَهُ اللّٰهُ نَكَالَ الْاٰخِرَةِ وَالْاُوْلٰىۗ",
          "transliteration": "Fa akhażahullāhu nakālal-ākhirati wal-ūlā.",
          "indonesianTranslation": "Maka, Allah menghukumnya dengan azab di akhirat dan (siksaan) di dunia.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 26,
          "text": "اِنَّ فِيْ ذٰلِكَ لَعِبْرَةً لِّمَنْ يَّخْشٰى ۗ ࣖ",
          "transliteration": "Inna fī żālika la‘ibratal limay yakhsyā.",
          "indonesianTranslation": "Sesungguhnya pada yang demikian itu benar-benar terdapat pelajaran bagi orang yang takut (kepada Allah).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 27,
          "text": "ءَاَنْتُمْ اَشَدُّ خَلْقًا اَمِ السَّمَاۤءُ ۚ بَنٰىهَاۗ",
          "transliteration": "A'antum asyaddu khalqan amis-samā'u banāhā.",
          "indonesianTranslation": "Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 28,
          "text": "رَفَعَ سَمْكَهَا فَسَوّٰىهَاۙ",
          "transliteration": "Rafa‘a samkahā fa sawwāhā.",
          "indonesianTranslation": "Dia telah meninggikan bangunannya, lalu menyempurnakannya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 29,
          "text": "وَاَغْطَشَ لَيْلَهَا وَاَخْرَجَ ضُحٰىهَاۖ",
          "transliteration": "Wa agṭasya lailahā wa akhraja ḍuḥāhā.",
          "indonesianTranslation": "Dia menjadikan malamnya (gelap gulita) dan menjadikan siangnya (terang benderang).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 30,
          "text": "وَالْاَرْضَ بَعْدَ ذٰلِكَ دَحٰىهَاۗ",
          "transliteration": "Wal-arḍa ba‘da żālika daḥāhā.",
          "indonesianTranslation": "Setelah itu, bumi Dia hamparkan (untuk dihuni).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 31,
          "text": "اَخْرَجَ مِنْهَا مَاۤءَهَا وَمَرْعٰىهَاۖ",
          "transliteration": "Akhraja minhā mā'ahā wa mar‘āhā.",
          "indonesianTranslation": "Darinya (bumi) Dia mengeluarkan air dan (menyediakan) tempat penggembalaan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 32,
          "text": "وَالْجِبَالَ اَرْسٰىهَاۙ",
          "transliteration": "Wal-jibāla arsāhā.",
          "indonesianTranslation": "Gunung-gunung Dia pancangkan dengan kukuh.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 33,
          "text": "مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْۗ",
          "transliteration": "Matā‘al lakum wa li'an‘āmikum.",
          "indonesianTranslation": "(Semua itu disediakan) untuk kesenanganmu dan hewan ternakmu.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 34,
          "text": "فَاِذَا جَاۤءَتِ الطَّاۤمَّةُ الْكُبْرٰىۖ",
          "transliteration": "Fa iżā jā'atiṭ-ṭāmmatul-kubrā.",
          "indonesianTranslation": "Maka, apabila malapetaka terbesar (hari Kiamat) telah datang,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 35,
          "text": "يَوْمَ يَتَذَكَّرُ الْاِنْسَانُ مَا سَعٰىۙ",
          "transliteration": "Yauma yatażakkarul-insānu mā sa‘ā.",
          "indonesianTranslation": "pada hari (itu) manusia teringat apa yang telah dikerjakannya",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 36,
          "text": "وَبُرِّزَتِ الْجَحِيْمُ لِمَنْ يَّرٰى",
          "transliteration": "Wa burrizatil-jaḥīmu limay yarā.",
          "indonesianTranslation": "dan (neraka) Jahim diperlihatkan dengan jelas kepada orang yang melihat(-nya).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 37,
          "text": "فَاَمَّا مَنْ طَغٰىۖ",
          "transliteration": "Fa ammā man ṭagā.",
          "indonesianTranslation": "Adapun orang yang melampaui batas",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 38,
          "text": "وَاٰثَرَ الْحَيٰوةَ الدُّنْيَاۙ",
          "transliteration": "Wa āṡaral-ḥayātad-dun-yā.",
          "indonesianTranslation": "dan lebih mengutamakan kehidupan dunia,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 39,
          "text": "فَاِنَّ الْجَحِيْمَ هِيَ الْمَأْوٰىۗ",
          "transliteration": "Fa innal-jaḥīma hiyal-ma'wā.",
          "indonesianTranslation": "sesungguhnya (neraka) Jahimlah tempat tinggal(-nya).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 40,
          "text": "وَاَمَّا مَنْ خَافَ مَقَامَ رَبِّهٖ وَنَهَى النَّفْسَ عَنِ الْهَوٰىۙ",
          "transliteration": "Wa ammā man khāfa maqāma rabbihī wa nahan-nafsa ‘anil-hawā.",
          "indonesianTranslation": "Adapun orang-orang yang takut pada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 41,
          "text": "فَاِنَّ الْجَنَّةَ هِيَ الْمَأْوٰىۗ",
          "transliteration": "Fa innal-jannata hiyal-ma'wā.",
          "indonesianTranslation": "sesungguhnya surgalah tempat tinggal(-nya).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 42,
          "text": "يَسْـَٔلُوْنَكَ عَنِ السَّاعَةِ اَيَّانَ مُرْسٰىهَاۗ",
          "transliteration": "Yas'alūnaka ‘anis-sā‘ati ayyāna mursāhā.",
          "indonesianTranslation": "Mereka (orang-orang kafir) bertanya kepadamu (Nabi Muhammad) tentang hari Kiamat, “Kapankah terjadinya?”",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 43,
          "text": "فِيْمَ اَنْتَ مِنْ ذِكْرٰىهَاۗ",
          "transliteration": "Fīma anta min żikrāhā.",
          "indonesianTranslation": "Untuk apa engkau perlu menyebutkan (waktu)-nya?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 44,
          "text": "اِلٰى رَبِّكَ مُنْتَهٰىهَاۗ",
          "transliteration": "Ilā rabbika muntahāhā.",
          "indonesianTranslation": "Kepada Tuhanmulah (dikembalikan) kesudahan (ketentuan waktu)-nya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 45,
          "text": "اِنَّمَآ اَنْتَ مُنْذِرُ مَنْ يَّخْشٰىهَاۗ",
          "transliteration": "Innamā anta munżiru may yakhsyāhā.",
          "indonesianTranslation": "Engkau (Nabi Muhammad) hanyalah pemberi peringatan kepada siapa yang takut padanya (hari Kiamat).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 46,
          "text": "كَاَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوْٓا اِلَّا عَشِيَّةً اَوْ ضُحٰىهَا ࣖ",
          "transliteration": "Ka'annahum yauma yaraunahā lam yalbaṡū illā ‘asyiyyatan au ḍuḥāhā.",
          "indonesianTranslation": "Pada hari ketika melihatnya (hari Kiamat itu), mereka merasa seakan-akan hanya (sebentar) tinggal (di dunia) pada waktu petang atau pagi.",
          "juz": null,
          "page": null,
          "ruku": null
        }
      ]
    }
  ]
}