  ],
  "totalSurahs": 3,
  "scrapedAt": "2026-03-12T18:05:14.027Z",
  "surahs": [
    {
      "number": 80,
      "name": "عبس",
      "englishName": "'Abasa",
      "englishNameTranslation": "Bermuka Masam",
      "numberOfAyahs": 42,
      "revelationType": "Medinan",
      "verses": [
        {
          "number": 1,
          "text": "عَبَسَ وَتَوَلّٰىٓۙ",
          "transliteration": "‘Abasa wa tawallā.",
          "indonesianTranslation": "Dia (Nabi Muhammad) berwajah masam dan berpaling",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 2,
          "text": "اَنْ جَاۤءَهُ الْاَعْمٰىۗ",
          "transliteration": "An jā'ahul-a‘mā.",
          "indonesianTranslation": "karena seorang tunanetra (Abdullah bin Ummi Maktum) telah datang kepadanya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 3,
          "text": "وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰىٓۙ",
          "transliteration": "Wa mā yudrīka la‘allahū yazzakkā.",
          "indonesianTranslation": "Tahukah engkau (Nabi Muhammad) boleh jadi dia ingin menyucikan dirinya (dari dosa)",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 4,
          "text": "اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۗ",
          "transliteration": "Au yażżakkaru fatanfa‘ahuż-żikrā.",
          "indonesianTranslation": "atau dia (ingin) mendapatkan pengajaran sehingga pengajaran itu bermanfaat baginya?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 5,
          "text": "اَمَّا مَنِ اسْتَغْنٰىۙ",
          "transliteration": "Ammā manistagnā.",
          "indonesianTranslation": "Adapun orang yang merasa dirinya serba cukup (para pembesar Quraisy),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 6,
          "text": "فَاَنْتَ لَهٗ تَصَدّٰىۗ",
          "transliteration": "Fa anta lahū taṣaddā.",
          "indonesianTranslation": "engkau (Nabi Muhammad) memberi perhatian kepadanya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 7,
          "text": "وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۗ",
          "transliteration": "Wa mā ‘alaika allā yazzakkā.",
          "indonesianTranslation": "Padahal, tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 8,
          "text": "وَاَمَّا مَنْ جَاۤءَكَ يَسْعٰىۙ",
          "transliteration": "Wa ammā man jā'aka yas‘ā.",
          "indonesianTranslation": "Adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 9,
          "text": "وَهُوَ يَخْشٰىۙ",
          "transliteration": "Wa huwa yakhsyā.",
          "indonesianTranslation": "sedangkan dia takut (kepada Allah),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 10,
          "text": "فَاَنْتَ عَنْهُ تَلَهّٰىۚ",
          "transliteration": "Fa anta ‘anhu talahhā.",
          "indonesianTranslation": "malah engkau (Nabi Muhammad) abaikan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 11,
          "text": "كَلَّآ اِنَّهَا تَذْكِرَةٌ ۚ",
          "transliteration": "Kallā innahā tażkirah(tun).",
          "indonesianTranslation": "Sekali-kali jangan (begitu)! Sesungguhnya (ajaran Allah) itu merupakan peringatan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 12,
          "text": "فَمَنْ شَاۤءَ ذَكَرَهٗ ۘ",
          "transliteration": "Faman syā'a żakarah(ū).",
          "indonesianTranslation": "Siapa yang menghendaki tentulah akan memperhatikannya",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 13,
          "text": "فِيْ صُحُفٍ مُّكَرَّمَةٍۙ",
          "transliteration": "Fī ṣuḥufim mukarrmah(tin).",
          "indonesianTranslation": "di dalam suhuf yang dimuliakan (di sisi Allah),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 14,
          "text": "مَّرْفُوْعَةٍ مُّطَهَّرَةٍ ۢ ۙ",
          "transliteration": "Marfū‘atim muṭahharah(tin).",
          "indonesianTranslation": "yang ditinggikan (kedudukannya) lagi disucikan",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 15,
          "text": "بِاَيْدِيْ سَفَرَةٍۙ",
          "transliteration": "Bi'aidī safarah(tin).",
          "indonesianTranslation": "di tangan para utusan (malaikat)",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 16,
          "text": "كِرَامٍۢ بَرَرَةٍۗ",
          "transliteration": "Kirāmim bararah(tin).",
          "indonesianTranslation": "yang mulia lagi berbudi.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 17,
          "text": "قُتِلَ الْاِنْسَانُ مَآ اَكْفَرَهٗۗ",
          "transliteration": "Qutilal-insānu mā akfarah(ū).",
          "indonesianTranslation": "Celakalah manusia! Alangkah kufur dia!",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 18,
          "text": "مِنْ اَيِّ شَيْءٍ خَلَقَهٗۗ",
          "transliteration": "Min ayyi syai'in khalaqah(ū).",
          "indonesianTranslation": "Dari apakah Dia menciptakannya?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 19,
          "text": "مِنْ نُّطْفَةٍۗ خَلَقَهٗ فَقَدَّرَهٗۗ",
          "transliteration": "Min nuṭfah(tin), khalaqahū fa qaddarah(ū).",
          "indonesianTranslation": "Dia menciptakannya dari setetes mani, lalu menentukan (takdir)-nya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 20,
          "text": "ثُمَّ السَّبِيْلَ يَسَّرَهٗۙ",
          "transliteration": "Ṡummas-sabīla yassarah(ū).",
          "indonesianTranslation": "Kemudian, jalannya Dia mudahkan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 21,
          "text": "ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗۙ",
          "transliteration": "Ṡumma amātahū fa aqbarah(ū).",
          "indonesianTranslation": "Kemudian, Dia mematikannya lalu menguburkannya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 22,
          "text": "ثُمَّ اِذَا شَاۤءَ اَنْشَرَهٗۗ",
          "transliteration": "Ṡumma iżā syā'a ansyarah(ū).",
          "indonesianTranslation": "Kemudian, jika menghendaki, Dia membangkitkannya kembali.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 23,
          "text": "كَلَّا لَمَّا يَقْضِ مَآ اَمَرَهٗۗ",
          "transliteration": "Kallā lammā yaqḍi mā amarah(ū).",
          "indonesianTranslation": "Sekali-kali jangan (begitu)! Dia (manusia) itu belum melaksanakan apa yang Dia (Allah) perintahkan kepadanya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 24,
          "text": "فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۙ ",
          "transliteration": "Falyanẓuril-insānu ilā ṭa‘āmih(ī).",
          "indonesianTranslation": "Maka, hendaklah manusia itu memperhatikan makanannya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 25,
          "text": "اَنَّا صَبَبْنَا الْمَاۤءَ صَبًّاۙ",
          "transliteration": "Annā ṣababnal-mā'a ṣabbā(n).",
          "indonesianTranslation": "Sesungguhnya Kami telah mencurahkan air (dari langit) dengan berlimpah.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 26,
          "text": "ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ",
          "transliteration": "Ṡumma syaqaqnal-arḍa syaqqā(n).",
          "indonesianTranslation": "Kemudian, Kami belah bumi dengan sebaik-baiknya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 27,
          "text": "فَاَنْۢبَتْنَا فِيْهَا حَبًّاۙ",
          "transliteration": "Fa'ambatnā fīhā ḥabbā(n).",
          "indonesianTranslation": "Lalu, Kami tumbuhkan padanya biji-bijian,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 28,
          "text": "وَّعِنَبًا وَّقَضْبًاۙ",
          "transliteration": "Wa ‘inabaw wa qaḍbā(n).",
          "indonesianTranslation": "anggur, sayur-sayuran,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 29,
          "text": "وَّزَيْتُوْنًا وَّنَخْلًاۙ",
          "transliteration": "Wa zaitūnaw wa nakhlā(n).",
          "indonesianTranslation": "zaitun, pohon kurma,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 30,
          "text": "وَّحَدَاۤىِٕقَ غُلْبًا",
          "transliteration": "Wa ḥadā'iqa gulbā(n).",
          "indonesianTranslation": "kebun-kebun (yang) rindang,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 31,
          "text": "وَفَاكِهَةً وَّاَبًّا",
          "transliteration": "Wa fākihataw wa abbā(n).",
          "indonesianTranslation": "buah-buahan, dan rerumputan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 32,
          "text": "مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْۗ",
          "transliteration": "Matā‘al lakum wa li'an‘āmikum.",
          "indonesianTranslation": "(Semua itu disediakan) untuk kesenanganmu dan hewan-hewan ternakmu.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 33,
          "text": "فَاِذَا جَاۤءَتِ الصَّاۤخَّةُ ۖ",
          "transliteration": "Fa iżā jā'atiṣ-ṣākhkhah(tu).",
          "indonesianTranslation": "Maka, apabila datang suara yang memekakkan (dari tiupan sangkakala),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 34,
          "text": "يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِۙ",
          "transliteration": "Yauma yafirrul-mar'u min akhīh(i).",
          "indonesianTranslation": "pada hari itu manusia lari dari saudaranya,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 35,
          "text": "وَاُمِّهٖ وَاَبِيْهِۙ",
          "transliteration": "Wa ummihī wa abīh(i).",
          "indonesianTranslation": "(dari) ibu dan bapaknya,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 36,
          "text": "وَصَاحِبَتِهٖ وَبَنِيْهِۗ",
          "transliteration": "Wa ṣāḥibatihī wa banīh(i).",
          "indonesianTranslation": "serta (dari) istri dan anak-anaknya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 37,
          "text": "لِكُلِّ امْرِئٍ مِّنْهُمْ يَوْمَىِٕذٍ شَأْنٌ يُّغْنِيْهِۗ",
          "transliteration": "Likullimri'im minhum yauma'iżin sya'nuy yugnīh(i).",
          "indonesianTranslation": "Setiap orang dari mereka pada hari itu mempunyai urusan yang menyibukkannya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 38,
          "text": "وُجُوْهٌ يَّوْمَىِٕذٍ مُّسْفِرَةٌۙ",
          "transliteration": "Wujūhuy yauma'iżim musfirah(tun).",
          "indonesianTranslation": "Pada hari itu ada wajah-wajah yang berseri-seri,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 39,
          "text": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۚ",
          "transliteration": "Ḍāḥikatum mustabsyirah(tun).",
          "indonesianTranslation": "tertawa lagi gembira ria.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 40,
          "text": "وَوُجُوْهٌ يَّوْمَىِٕذٍ عَلَيْهَا غَبَرَةٌۙ",
          "transliteration": "Wa wujūhuy yauma'iżin ‘alaihā gabarah(tun).",
          "indonesianTranslation": "Pada hari itu ada (pula) wajah-wajah yang tertutup debu (suram)",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 41,
          "text": "تَرْهَقُهَا قَتَرَةٌ ۗ",
          "transliteration": "Tarhaquhā qatarah(tun).",
          "indonesianTranslation": "dan tertutup oleh kegelapan (ditimpa kehinaan dan kesusahan).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 42,
          "text": "اُولٰۤىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ࣖ",
          "transliteration": "Ulā'ika humul-kafaratul-fajarah(tu).",
          "indonesianTranslation": "Mereka itulah orang-orang kafir lagi para pendurhaka.",
          "juz": null,
          "page": null,
          "ruku": null
        }
      ]
    },
    {
      "number": 81,
      "name": "التكوير",
      "englishName": "At-Takwir",
      "englishNameTranslation": "Penggulungan",
      "numberOfAyahs": 29,
      "revelationType": "Medinan",
      "verses": [
        {
          "number": 1,
          "text": "اِذَا الشَّمْسُ كُوِّرَتْۖ",
          "transliteration": "Iżasy-syamsu kuwwirat.",
          "indonesianTranslation": "Apabila matahari digulung,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 2,
          "text": "وَاِذَا النُّجُوْمُ انْكَدَرَتْۖ",
          "transliteration": "Wa iżan-nujūmunkadarat.",
          "indonesianTranslation": "apabila bintang-bintang berjatuhan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 3,
          "text": "وَاِذَا الْجِبَالُ سُيِّرَتْۖ",
          "transliteration": "Wa iżal-jibālu suyyirat.",
          "indonesianTranslation": "apabila gunung-gunung dihancurkan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 4,
          "text": "وَاِذَا الْعِشَارُ عُطِّلَتْۖ",
          "transliteration": "Wa iżal-‘isyāru ‘uṭṭilat.",
          "indonesianTranslation": "apabila unta-unta yang bunting ditinggalkan (tidak terurus),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 5,
          "text": "وَاِذَا الْوُحُوْشُ حُشِرَتْۖ",
          "transliteration": "Wa iżal-wuḥūsy ḥusyirat.",
          "indonesianTranslation": "apabila binatang-binatang liar dikumpulkan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 6,
          "text": "وَاِذَا الْبِحَارُ سُجِّرَتْۖ",
          "transliteration": "Wa iżal-biḥāru sujjirat.",
          "indonesianTranslation": "apabila lautan dipanaskan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 7,
          "text": "وَاِذَا النُّفُوْسُ زُوِّجَتْۖ",
          "transliteration": "Wa iżan-nufūsu zuwwijat.",
          "indonesianTranslation": "apabila roh-roh dipertemukan (dengan tubuh),",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 8,
          "text": "وَاِذَا الْمَوْءٗدَةُ سُىِٕلَتْۖ ",
          "transliteration": "Wa iżal-mau'ūdatu su'ilat.",
          "indonesianTranslation": "apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 9,
          "text": "بِاَيِّ ذَنْۢبٍ قُتِلَتْۚ",
          "transliteration": "Bi'ayyi żambin qutilat.",
          "indonesianTranslation": "“Karena dosa apa dia dibunuh,”",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 10,
          "text": "وَاِذَا الصُّحُفُ نُشِرَتْۖ",
          "transliteration": "Wa iżaṣ-ṣuḥufu nusyirat.",
          "indonesianTranslation": "apabila lembaran-lembaran (catatan amal) telah dibuka lebar-lebar,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 11,
          "text": "وَاِذَا السَّمَاۤءُ كُشِطَتْۖ",
          "transliteration": "Wa iżas-samā'u kusyiṭat.",
          "indonesianTranslation": "apabila langit dilenyapkan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 12,
          "text": "وَاِذَا الْجَحِيْمُ سُعِّرَتْۖ",
          "transliteration": "Wa iżal-jaḥīmu su‘‘irat.",
          "indonesianTranslation": "apabila (neraka) Jahim dinyalakan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 13,
          "text": "وَاِذَا الْجَنَّةُ اُزْلِفَتْۖ",
          "transliteration": "Wa iżal-jannatu uzlifat.",
          "indonesianTranslation": "dan apabila surga didekatkan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 14,
          "text": "عَلِمَتْ نَفْسٌ مَّآ اَحْضَرَتْۗ",
          "transliteration": "‘Alimat nafsum mā aḥḍarat.",
          "indonesianTranslation": "setiap jiwa akan mengetahui apa yang telah dikerjakannya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 15,
          "text": "فَلَآ اُقْسِمُ بِالْخُنَّسِۙ",
          "transliteration": "Falā uqsimu bil-khunnas(i).",
          "indonesianTranslation": "Aku bersumpah demi bintang-bintang",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 16,
          "text": "الْجَوَارِ الْكُنَّسِۙ",
          "transliteration": "Al-jawāril-kunnas(i).",
          "indonesianTranslation": "yang beredar lagi terbenam,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 17,
          "text": "وَالَّيْلِ اِذَا عَسْعَسَۙ",
          "transliteration": "Wal-laili iżā ‘as‘as(a).",
          "indonesianTranslation": "demi malam apabila telah larut,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 18,
          "text": "وَالصُّبْحِ اِذَا تَنَفَّسَۙ",
          "transliteration": "Waṣ-ṣubḥi iżā tanaffas(a).",
          "indonesianTranslation": "demi subuh apabila (fajar) telah menyingsing,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 19,
          "text": "اِنَّهٗ لَقَوْلُ رَسُوْلٍ كَرِيْمٍۙ",
          "transliteration": "Innahū laqaulu rasūlin karīm(in).",
          "indonesianTranslation": "sesungguhnya (Al-Qur’an) itu benar-benar firman (Allah yang dibawa oleh) utusan yang mulia (Jibril)",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 20,
          "text": "ذِيْ قُوَّةٍ عِنْدَ ذِى الْعَرْشِ مَكِيْنٍۙ",
          "transliteration": "Żī quwwatin ‘inda żil-‘arsyi makīn(in).",
          "indonesianTranslation": "yang memiliki kekuatan dan kedudukan tinggi di sisi (Allah) yang memiliki ʻArasy,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 21,
          "text": "مُّطَاعٍ ثَمَّ اَمِيْنٍۗ",
          "transliteration": "Muṭā‘in ṡamma amīn(in).",
          "indonesianTranslation": "yang di sana (Jibril) ditaati lagi dipercaya.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 22,
          "text": "وَمَا صَاحِبُكُمْ بِمَجْنُوْنٍۚ",
          "transliteration": "Wa mā ṣāḥibukum bimajnūn(in).",
          "indonesianTranslation": "Temanmu (Nabi Muhammad) itu bukanlah orang gila.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 23,
          "text": "وَلَقَدْ رَاٰهُ بِالْاُفُقِ الْمُبِيْنِۚ",
          "transliteration": "Wa laqad ra'āhu bil-ufuqil-mubīn(i).",
          "indonesianTranslation": "Sungguh, dia (Nabi Muhammad) benar-benar telah melihatnya (Jibril) di ufuk yang terang.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 24,
          "text": "وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِيْنٍۚ",
          "transliteration": "Wa mā huwa ‘alal-gaibi biḍanīn(in).",
          "indonesianTranslation": "Dia (Nabi Muhammad) bukanlah seorang yang kikir (enggan) untuk menerangkan yang gaib.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 25,
          "text": "وَمَا هُوَ بِقَوْلِ شَيْطٰنٍ رَّجِيْمٍۚ",
          "transliteration": "Wa mā huwa biqauli syaiṭānir rajīm(in).",
          "indonesianTranslation": "(Al-Qur’an) itu bukanlah perkataan setan yang terkutuk.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 26,
          "text": "فَاَيْنَ تَذْهَبُوْنَۗ",
          "transliteration": "Fa aina tażhabūn(a).",
          "indonesianTranslation": "Maka, ke manakah kamu akan pergi?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 27,
          "text": "اِنْ هُوَ اِلَّا ذِكْرٌ لِّلْعٰلَمِيْنَۙ",
          "transliteration": "In huwa illā żikrul lil-‘ālamīn(a).",
          "indonesianTranslation": "(Al-Qur’an) itu tidak lain, kecuali peringatan bagi semesta alam,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 28,
          "text": "لِمَنْ شَاۤءَ مِنْكُمْ اَنْ يَّسْتَقِيْمَۗ",
          "transliteration": "Liman syā'a minkum ay yastaqīm(a).",
          "indonesianTranslation": "(yaitu) bagi siapa di antaramu yang hendak menempuh jalan yang lurus.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 29,
          "text": "وَمَا تَشَاۤءُوْنَ اِلَّآ اَنْ يَّشَاۤءَ اللّٰهُ رَبُّ الْعٰلَمِيْنَ ࣖ",
          "transliteration": "Wa mā tasyā'ūna illā ay yasyā'allāhu rabbul-‘ālamīn(a).",
          "indonesianTranslation": "Kamu tidak dapat berkehendak, kecuali apabila dikehendaki Allah, Tuhan semesta alam.",
          "juz": null,
          "page": null,
          "ruku": null
        }
      ]
    },
    {
      "number": 82,
