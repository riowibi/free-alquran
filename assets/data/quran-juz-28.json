      "numberOfAyahs": 19,
      "revelationType": "Medinan",
      "verses": [
        {
          "number": 1,
          "text": "اِذَا السَّمَاۤءُ انْفَطَرَتْۙ",
          "transliteration": "Iżas-samā'unfaṭarat.",
          "indonesianTranslation": "Apabila langit terbelah,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 2,
          "text": "وَاِذَا الْكَوَاكِبُ انْتَثَرَتْۙ",
          "transliteration": "Wa iżal-kawākibuntaṡarat.",
          "indonesianTranslation": "apabila bintang-bintang jatuh berserakan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 3,
          "text": "وَاِذَا الْبِحَارُ فُجِّرَتْۙ",
          "transliteration": "Wa iżal-biḥāru fujjirat.",
          "indonesianTranslation": "apabila lautan diluapkan,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 4,
          "text": "وَاِذَا الْقُبُوْرُ بُعْثِرَتْۙ",
          "transliteration": "Wa iżal-qubūru bu‘ṡirat.",
          "indonesianTranslation": "dan apabila kuburan-kuburan dibongkar,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 5,
          "text": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَاَخَّرَتْۗ",
          "transliteration": "‘Alimat nafsum mā qaddamat wa akhkharat.",
          "indonesianTranslation": "setiap jiwa akan mengetahui apa yang telah dikerjakan dan yang dilalaikan(-nya).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 6,
          "text": "يٰٓاَيُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيْمِۙ",
          "transliteration": "Yā ayyuhal-insānu mā garraka birabbikal-karīm(i).",
          "indonesianTranslation": "Wahai manusia, apakah yang telah memperdayakanmu (berbuat durhaka) terhadap Tuhanmu Yang Maha Mulia,",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 7,
          "text": "الَّذِيْ خَلَقَكَ فَسَوّٰىكَ فَعَدَلَكَۙ",
          "transliteration": "Allażī khalaqaka fa sawwāka fa ‘adalak(a).",
          "indonesianTranslation": "yang telah menciptakanmu lalu menyempurnakan kejadianmu dan menjadikan (susunan tubuh)-mu seimbang?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 8,
          "text": "فِيْٓ اَيِّ صُوْرَةٍ مَّا شَاۤءَ رَكَّبَكَۗ",
          "transliteration": "Fī ayyi ṣūratim mā syā'a rakkabak(a).",
          "indonesianTranslation": "Dalam bentuk apa saja yang dikehendaki, Dia menyusun (tubuh)-mu.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 9,
          "text": "كَلَّا بَلْ تُكَذِّبُوْنَ بِالدِّيْنِۙ",
          "transliteration": "Kallā bal tukażżibūna bid-dīn(i).",
          "indonesianTranslation": "Jangan sekali-kali begitu! Bahkan, kamu mendustakan hari Pembalasan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 10,
          "text": "وَاِنَّ عَلَيْكُمْ لَحٰفِظِيْنَۙ",
          "transliteration": "Wa inna ‘alaikum laḥāfiẓīn(a).",
          "indonesianTranslation": "Sesungguhnya bagi kamu ada (malaikat-malaikat) pengawas",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 11,
          "text": "كِرَامًا كٰتِبِيْنَۙ",
          "transliteration": "Kirāman kātibīn(a).",
          "indonesianTranslation": "yang mulia (di sisi Allah) dan mencatat (amal perbuatanmu).",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 12,
          "text": "يَعْلَمُوْنَ مَا تَفْعَلُوْنَ",
          "transliteration": "Ya‘lamūna mā taf‘alūn(a).",
          "indonesianTranslation": "Mereka mengetahui apa yang kamu kerjakan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 13,
          "text": "اِنَّ الْاَبْرَارَ لَفِيْ نَعِيْمٍۙ",
          "transliteration": "Innal-abrāra lafī na‘īm(in).",
          "indonesianTranslation": "Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 14,
          "text": "وَّاِنَّ الْفُجَّارَ لَفِيْ جَحِيْمٍ",
          "transliteration": "Wa innal-fujjāra lafī jaḥīm(in).",
          "indonesianTranslation": "Sesungguhnya orang-orang yang durhaka benar-benar berada dalam (neraka) Jahim.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 15,
          "text": "يَصْلَوْنَهَا يَوْمَ الدِّيْنِ",
          "transliteration": "Yaṣlaunahā yaumad-dīn(i).",
          "indonesianTranslation": "Mereka memasukinya pada hari Pembalasan.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 16,
          "text": "وَمَا هُمْ عَنْهَا بِغَاۤىِٕبِيْنَۗ",
          "transliteration": "Wa mā hum ‘anhā bigā'ibīn(a). ",
          "indonesianTranslation": "Mereka tidak mungkin keluar dari (neraka) itu.",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 17,
          "text": "وَمَآ اَدْرٰىكَ مَا يَوْمُ الدِّيْنِۙ",
          "transliteration": "Wa mā adrāka mā yaumud-dīn(i).",
          "indonesianTranslation": "Tahukah engkau apakah hari Pembalasan itu?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 18,
          "text": "ثُمَّ مَآ اَدْرٰىكَ مَا يَوْمُ الدِّيْنِۗ",
          "transliteration": "Ṡumma mā adrāka mā yaumud-dīn(i).",
          "indonesianTranslation": "Kemudian, tahukah engkau apakah hari Pembalasan itu?",
          "juz": null,
          "page": null,
          "ruku": null
        },
        {
          "number": 19,
          "text": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۗوَالْاَمْرُ يَوْمَىِٕذٍ لِّلّٰهِ ࣖ",
          "transliteration": "Yauma lā tamliku nafsul linafsin syai'ā(n), wal-amru yauma'iżil lillāh(i).",
          "indonesianTranslation": "(Itulah) hari (ketika) seseorang tidak berdaya (menolong) orang lain sedikit pun. Segala urusan pada hari itu adalah milik Allah.",
          "juz": null,
          "page": null,
          "ruku": null
        }
